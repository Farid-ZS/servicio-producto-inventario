# Variables de entorno para ejecución local (fuera de Docker).
# Copiar este archivo como .env y ajustar los valores.

# Autenticación
JWT_SECRET=dev-user-secret-change-me
INTERNAL_JWT_SECRET=dev-internal-secret-change-me

# Infraestructura compartida
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Servicio de Productos (puerto 3001)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db_core
INVENTARIO_URL=http://localhost:3002

# Servicio de Inventario (puerto 3002)
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/db_operaciones